    {
      "parameters": {
        "jsCode": "const editFields = $('Edit Fields').first().json;\nconst periodo = editFields.periodo;\nconst requiereIntervencion = editFields.RequiereIntervencion;\n\nlet resumenTecnico = null;\ntry {\n  resumenTecnico = $('AI Agent_Resumen Tecnico').first().json.output;\n} catch (e) {\n  resumenTecnico = null;\n}\n\nconst resumenConsolidado = resumenTecnico\n  ? resumenTecnico.asunto_principal + ' | Acción requerida: ' + resumenTecnico.accion_requerida\n  : editFields.Resultado;\n\nconst estadoDelCaso = requiereIntervencion ? 'Requiere intervención' : 'Cerrado OK';\n\nreturn [{\n  json: {\n    Session_ID: periodo,\n    Fecha_Actualizacion: new Date().toISOString().split('T')[0],\n    Resumen_Consolidado: resumenConsolidado,\n    Estado_Del_Caso: estadoDelCaso,\n    Datos_Clave: resumenTecnico ? JSON.stringify(resumenTecnico.puntos_clave) : 'Sin resumen técnico generado — conversación corta (5 mensajes o menos)'\n  }\n}];"
      },
