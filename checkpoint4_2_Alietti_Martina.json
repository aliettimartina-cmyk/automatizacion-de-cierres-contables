    {
      "parameters": {
        "jsCode": "const texto = $input.first().json.chatInput || '';\nlet periodo = null;\n\n// Formato AAAA-MM directo (ej: 2026-06)\nconst matchISO = texto.match(/\\b(\\d{4})-(\\d{2})\\b/);\nif (matchISO) {\n  periodo = matchISO[0];\n} else {\n  // Formato DD/MM/AAAA (ej: 30/06/2026) -> normalizar a AAAA-MM\n  const matchDMY = texto.match(/\\b(\\d{2})\\/(\\d{2})\\/(\\d{4})\\b/);\n  if (matchDMY) {\n    const [, , mm, yyyy] = matchDMY;\n    periodo = `${yyyy}-${mm}`;\n  }\n}\n\nreturn [{ json: { ...$input.first().json, periodo } }];"
      },
