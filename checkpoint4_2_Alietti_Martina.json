    {
      "parameters": {
        "jsCode": "const messages = $('Chat Memory Manager').first().json.messages;\nlet historialTexto = JSON.stringify(messages);\n\n// Normaliza cualquier fecha DD/MM/AAAA a AAAA-MM antes de que el agente la lea\nhistorialTexto = historialTexto.replace(/(\\d{2})\\/(\\d{2})\\/(\\d{4})/g, (match, dd, mm, yyyy) => `${yyyy}-${mm}`);\n\nreturn [{ json: { historialNormalizado: historialTexto } }];"
      },
