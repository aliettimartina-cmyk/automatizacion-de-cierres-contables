      "parameters": {
        "jsCode": "const original = $('Code in JavaScript_Extraer Periodo del Mensaje').first().json;\nconst airtableResult = $input.first().json;\nconst encontrado = !!(airtableResult.fields && airtableResult.fields.Session_ID);\n\nconst bloqueMemoria = encontrado\n  ? 'Período consultado: ' + original.periodo + '. Estado del último cierre registrado para este período: ' + airtableResult.fields.Estado_Del_Caso + '. Resumen de la última ejecución: ' + airtableResult.fields.Resumen_Consolidado + '. Datos clave: ' + airtableResult.fields.Datos_Clave\n  : 'No hay registro previo de memoria para este período — es la primera vez que se procesa.';\n\nreturn [{\n  json: {\n    chatInput: original.chatInput,\n    action: original.action,\n    sessionId: original.sessionId,\n    periodo: original.periodo,\n    airtable_encontrado: encontrado,\n    Session_ID: encontrado ? airtableResult.fields.Session_ID : null,\n    Resumen_Consolidado: encontrado ? airtableResult.fields.Resumen_Consolidado : null,\n    Estado_Del_Caso: encontrado ? airtableResult.fields.Estado_Del_Caso : null,\n    Datos_Clave: encontrado ? airtableResult.fields.Datos_Clave : null,\n    bloqueMemoria: bloqueMemoria\n  }\n}];"
      },
